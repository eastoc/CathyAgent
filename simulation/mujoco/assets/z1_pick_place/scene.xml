<mujoco model="Z1 tabletop pick and place">
  <include file="robot.xml"/>
  <option timestep="0.002" gravity="0 0 -9.81" integrator="implicitfast" cone="elliptic" impratio="10"/>
  <visual>
    <global offwidth="1280" offheight="960" azimuth="135" elevation="-28"/>
    <headlight ambient="0.35 0.35 0.35" diffuse="0.7 0.7 0.7" specular="0.2 0.2 0.2"/>
    <map znear="0.003" zfar="8"/>
    <quality shadowsize="2048"/>
  </visual>
  <statistic center="0 0 0.9" extent="1.4"/>
  <default>
    <geom friction="3 0.01 0.001" solref="0.003 1" condim="4"/>
    <default class="block">
      <geom type="box" size="0.0175 0.0175 0.0175" mass="0.055"
            friction="3 0.01 0.001" condim="4" solref="0.003 1"/>
    </default>
    <default class="tray">
      <geom type="box" material="tray_mat" friction="3 0.01 0.001"/>
    </default>
  </default>
  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.15 0.20 0.28" rgb2="0.035 0.05 0.075" width="256" height="1536"/>
    <texture name="floor_grid" type="2d" builtin="checker" rgb1="0.10 0.13 0.17" rgb2="0.13 0.16 0.20" width="256" height="256"/>
    <material name="floor_mat" texture="floor_grid" texrepeat="4 4" texuniform="true" reflectance="0.05"/>
    <material name="table_mat" rgba="0.64 0.55 0.41 1" shininess="0.15" specular="0.18"/>
    <material name="leg_mat" rgba="0.12 0.15 0.19 1"/>
    <material name="tray_mat" rgba="0.34 0.46 0.52 1" specular="0.2"/>
  </asset>
  <worldbody>
    <light pos="0.2 -0.5 2.5" dir="0 0 -1" diffuse="0.85 0.85 0.85"/>
    <light pos="-0.8 0.5 1.7" dir="0.4 -0.2 -1" diffuse="0.45 0.45 0.5" castshadow="false"/>
    <geom name="floor" type="plane" size="3 3 0.05" material="floor_mat"/>
    <body name="table">
      <geom name="table_top" type="box" pos="0 0 0.715" size="0.60 0.42 0.035" material="table_mat"/>
      <geom type="box" pos="-0.53 -0.35 0.34" size="0.035 0.035 0.34" material="leg_mat"/>
      <geom type="box" pos="0.53 -0.35 0.34" size="0.035 0.035 0.34" material="leg_mat"/>
      <geom type="box" pos="-0.53 0.35 0.34" size="0.035 0.035 0.34" material="leg_mat"/>
      <geom type="box" pos="0.53 0.35 0.34" size="0.035 0.035 0.34" material="leg_mat"/>
    </body>
    <body name="red_cube" pos="0.06 -0.13 0.768">
      <freejoint name="red_cube_free"/>
      <geom name="red_cube_geom" class="block" rgba="0.88 0.045 0.045 1"/>
    </body>
    <body name="blue_cube" pos="0.10 -0.015 0.768">
      <freejoint name="blue_cube_free"/>
      <geom name="blue_cube_geom" class="block" rgba="0.025 0.21 0.95 1"/>
    </body>
    <body name="green_cube" pos="-0.02 0.005 0.768">
      <freejoint name="green_cube_free"/>
      <geom name="green_cube_geom" class="block" rgba="0.035 0.68 0.13 1"/>
    </body>
    <!-- Open container: separate bottom + four collision walls, no top. -->
    <body name="container" pos="0.015 0.20 0.75">
      <geom name="container_bottom" class="tray" pos="0 0 0.006" size="0.103 0.093 0.006"/>
      <geom name="container_left" class="tray" pos="-0.099 0 0.037" size="0.004 0.093 0.037"/>
      <geom name="container_right" class="tray" pos="0.099 0 0.037" size="0.004 0.093 0.037"/>
      <geom name="container_front" class="tray" pos="0 -0.089 0.037" size="0.095 0.004 0.037"/>
      <geom name="container_back" class="tray" pos="0 0.089 0.037" size="0.095 0.004 0.037"/>
      <site name="place_target" pos="0 0 0.10" size="0.006" rgba="1 0.8 0.2 0" group="4"/>
    </body>
    <camera name="overview" pos="0.90 -0.95 1.65"
      xyaxes="0.748259907 0.663405691 0 -0.351537796 0.396501933 0.848060962" fovy="55"/>
    <camera name="top" pos="0.04 0.02 1.85" xyaxes="1 0 0 0 1 0" fovy="58"/>
  </worldbody>
</mujoco>
